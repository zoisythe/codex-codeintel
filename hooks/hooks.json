{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
						"timeout": 10,
						"statusMessage": "registering optional diagnostic baseline"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
						"timeout": 3,
						"statusMessage": "clearing LSP session state"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(apply_patch|Write|Edit|MultiEdit|multi_edit|write|edit|multiedit|Bash|bash|shell|Shell|exec_command|unified_exec)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
						"timeout": 10,
						"statusMessage": "checking automatic LSP and lint diagnostics"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
						"timeout": 50,
						"statusMessage": "reporting current diagnostics"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
						"timeout": 50,
						"statusMessage": "reporting current diagnostics"
					}
				]
			}
		]
	}
}
